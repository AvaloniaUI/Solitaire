<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Solitaire.Controls">
    <ControlTemplate x:Key="ConnectedTrayTemplate" TargetType="controls:ConnectedTray">
        <Panel>
            <controls:GoldTrayBorder Theme="{StaticResource goldenTrayBorderTheme}" Surface="Outer"
                                     Classes="goldenTrayBorder" IsHitTestVisible="False"
                                     IsVisible="{TemplateBinding (controls:ConnectedTray.FrameVisible)}"
                                     BoxShadow="{TemplateBinding (controls:ConnectedTray.FrameShadow)}">
                <controls:GoldTrayBorder Theme="{StaticResource goldenTrayInnerTheme}" Surface="Inner"
                                         Classes="goldenTrayInner">
                    <Border Theme="{StaticResource goldenTrayInnerBgTheme}" Classes="goldenTrayInnerBg" />
                </controls:GoldTrayBorder>
            </controls:GoldTrayBorder>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding (controls:ConnectedTray.Content)}"
                              ContentTemplate="{TemplateBinding (controls:ConnectedTray.ContentTemplate)}"
                              Padding="{TemplateBinding (controls:ConnectedTray.Padding)}"
                              HorizontalContentAlignment="{TemplateBinding (controls:ConnectedTray.HorizontalContentAlignment)}"
                              VerticalContentAlignment="{TemplateBinding (controls:ConnectedTray.VerticalContentAlignment)}" />
        </Panel>
    </ControlTemplate>
    <ControlTheme x:Key="{x:Type controls:ConnectedTray}" TargetType="controls:ConnectedTray">
        <Setter Property="FrameShadow" Value="0 20 60 -20 Black" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource CasinoFont}" />
        <Setter Property="Template" Value="{StaticResource ConnectedTrayTemplate}" />
    </ControlTheme>
    <ControlTheme x:Key="{x:Type controls:AnimatedTrayFrame}" TargetType="controls:AnimatedTrayFrame">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Canvas ClipToBounds="False">
                    <controls:TrayFrameBorder Name="PART_Outer" Classes="goldenTrayBorder"
                                              Theme="{StaticResource goldenTrayBorderTheme}" Surface="Outer"
                                              Width="1" Height="1" IsHitTestVisible="False"
                                              RenderTransformOrigin="0,0" />
                    <controls:TrayFrameBorder Name="PART_Inner" Classes="goldenTrayInner"
                                              Theme="{StaticResource goldenTrayInnerTheme}" Surface="Inner"
                                              Width="1" Height="1" IsHitTestVisible="False"
                                              RenderTransformOrigin="0,0">
                        <controls:TrayFrameBorder.RenderTransform><TranslateTransform X="8" Y="8" /></controls:TrayFrameBorder.RenderTransform>
                    </controls:TrayFrameBorder>
                    <controls:TrayFrameBorder Name="PART_Background" Classes="goldenTrayInnerBg"
                                              Theme="{StaticResource goldenTrayInnerBgTheme}"
                                              Width="1" Height="1" IsHitTestVisible="False"
                                              RenderTransformOrigin="0,0">
                        <controls:TrayFrameBorder.RenderTransform><TranslateTransform X="10" Y="10" /></controls:TrayFrameBorder.RenderTransform>
                    </controls:TrayFrameBorder>
                </Canvas>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
