<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Solitaire.Converters"
        xmlns:vm="clr-namespace:Solitaire.ViewModels"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        xmlns:controls="clr-namespace:Solitaire.Controls"
        xmlns:pages="clr-namespace:Solitaire.ViewModels.Pages">
    <Styles.Resources>
        <converters:TimeSpanToShortStringConverter x:Key="TimeSpanToShortStringConverter" />
        <converters:PlayingCardToBrushConverter x:Key="PlayingCardToBrushConverter" />
        <x:Double x:Key="CardWidth">160</x:Double>
        <x:Double x:Key="CardHeight">232</x:Double>
        <Thickness x:Key="CardThickness">8,10,40,40</Thickness>
        <Thickness x:Key="CardThicknessMobile">8,10,8,8</Thickness>
        <FontFamily x:Key="CasinoFont">/Assets/*.ttf#Quentell CF</FontFamily>
        <FontFamily x:Key="Inter">/Assets/*.ttf#Inter</FontFamily>
        <FontFamily x:Key="Nunito">/Assets/*.ttf#Nunito</FontFamily>

        <GradientStops x:Key="GoldBrush">
            <GradientStop Offset="0" Color="#FFFCFC80" />
            <GradientStop Offset="0.06861601" Color="#FFD09C14" />
            <GradientStop Offset="0.13723001" Color="#FFFCFC80" />
            <GradientStop Offset="0.2105" Color="#FFD09C14" />
            <GradientStop Offset="0.28178003" Color="#FFFCFC80" />
            <GradientStop Offset="0.36184004" Color="#FFD09C14" />
            <GradientStop Offset="0.45447004" Color="#FFFCFC80" />
            <GradientStop Offset="0.51927006" Color="#FFD09C14" />
            <GradientStop Offset="0.62017" Color="#FFFCFC80" />
            <GradientStop Offset="0.69228" Color="#FFD09C14" />
            <GradientStop Offset="0.78029996" Color="#FFFCFC80" />
            <GradientStop Offset="0.85488003" Color="#FFD09C14" />
            <GradientStop Offset="0.94064" Color="#FFFCFC80" />
            <GradientStop Offset="1" Color="#FFD09C14" />
        </GradientStops>

        <LinearGradientBrush x:Key="GoldenTrayOuterBorderRestBrush"
                             StartPoint="0,1254.2" EndPoint="1526.4,0"
                             GradientStops="{StaticResource GoldBrush}" />
        <LinearGradientBrush x:Key="GoldenTrayOuterBackgroundRestBrush"
                             StartPoint="-1000,1000" EndPoint="1000,0"
                             GradientStops="{StaticResource GoldBrush}"
                             Transform="rotate(120deg)" />
        <LinearGradientBrush x:Key="GoldenTrayInnerBorderRestBrush"
                             StartPoint="1200,600" EndPoint="1500,0"
                             GradientStops="{StaticResource GoldBrush}" />

        <Animation x:Key="GoldenTrayOuterBorderIdleAnimation" x:SetterTargetType="Border"
                   Duration="0:0:3" IterationCount="1"
                   PlaybackBehavior="OnlyIfVisible">
            <KeyFrame Cue="0%">
                <Setter Property="Border.BorderBrush" Value="{StaticResource GoldenTrayOuterBorderRestBrush}" />
            </KeyFrame>
            <KeyFrame Cue="50%">
                <Setter Property="Border.BorderBrush">
                    <LinearGradientBrush StartPoint="-1000,1254.2" EndPoint="1526.4,-344.22"
                                         GradientStops="{StaticResource GoldBrush}" />
                </Setter>
            </KeyFrame>
            <KeyFrame Cue="100%">
                <Setter Property="Border.BorderBrush" Value="{StaticResource GoldenTrayOuterBorderRestBrush}" />
            </KeyFrame>
        </Animation>

        <Animation x:Key="GoldenTrayOuterBackgroundIdleAnimation" x:SetterTargetType="Border"
                   Duration="0:0:3" IterationCount="1"
                   PlaybackBehavior="OnlyIfVisible">
            <KeyFrame Cue="0%">
                <Setter Property="Border.Background" Value="{StaticResource GoldenTrayOuterBackgroundRestBrush}" />
            </KeyFrame>
            <KeyFrame Cue="50%">
                <Setter Property="Border.Background">
                    <LinearGradientBrush StartPoint="-2000,1000" EndPoint="0,-1000"
                                         GradientStops="{StaticResource GoldBrush}" />
                </Setter>
            </KeyFrame>
            <KeyFrame Cue="100%">
                <Setter Property="Border.Background" Value="{StaticResource GoldenTrayOuterBackgroundRestBrush}" />
            </KeyFrame>
        </Animation>

        <Animation x:Key="GoldenTrayInnerBorderIdleAnimation" x:SetterTargetType="Border"
                   Duration="0:0:3" IterationCount="1"
                   PlaybackBehavior="OnlyIfVisible">
            <KeyFrame Cue="0%">
                <Setter Property="Border.BorderBrush" Value="{StaticResource GoldenTrayInnerBorderRestBrush}" />
            </KeyFrame>
            <KeyFrame Cue="50%">
                <Setter Property="Border.BorderBrush">
                    <LinearGradientBrush StartPoint="-1000,1000" EndPoint="1500,-600"
                                         GradientStops="{StaticResource GoldBrush}" />
                </Setter>
            </KeyFrame>
            <KeyFrame Cue="100%">
                <Setter Property="Border.BorderBrush" Value="{StaticResource GoldenTrayInnerBorderRestBrush}" />
            </KeyFrame>
        </Animation>

        <ControlTheme x:Key="goldenTrayBorderTheme" TargetType="Border">
            <Setter Property="(TextElement.FontFamily)" Value="{StaticResource CasinoFont}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldenTrayOuterBorderRestBrush}" />
            <Setter Property="Background" Value="{StaticResource GoldenTrayOuterBackgroundRestBrush}" />
        </ControlTheme>

        <ControlTheme x:Key="goldenTrayInnerTheme" TargetType="Border">
            <Setter Property="Background" Value="Black" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource GoldenTrayInnerBorderRestBrush}" />
        </ControlTheme>

        <ControlTheme x:Key="goldenTrayInnerBgTheme" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background">
                <VisualBrush TileMode="Tile" SourceRect="0,0,300,300"
                             DestinationRect="0,0,200,200">
                    <VisualBrush.Visual>
                        <Border Background="Black">
                            <controls:RandomNoiseTextureControl Opacity="0.1" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Border>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Setter>
        </ControlTheme>

        <ControlTemplate x:Key="WinDialog" x:DataType="vm:CardGameViewModel">
            <Border Background="#AA000000" x:CompileBindings="True" x:DataType="vm:CardGameViewModel">
                <controls:GoldTrayBorder Theme="{StaticResource goldenTrayBorderTheme}" Surface="Outer"
                                         Classes="goldenTrayBorder" Padding="0" MaxHeight="200" MaxWidth="400"
                                         BoxShadow="0 0 50 0 Black">
                    <controls:GoldTrayBorder Theme="{StaticResource goldenTrayInnerTheme}" Surface="Inner"
                                             Classes="goldenTrayInner" Margin="2">
                        <Border Theme="{StaticResource goldenTrayInnerBgTheme}" Classes="goldenTrayInnerBg">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical">
                                <TextBlock Name="header" TextAlignment="Center" Text="YOU WIN!" FontSize="64">
                                    <TextBlock.Foreground>
                                        <ConicGradientBrush Center="110%, -20%" Angle="180">
                                            <GradientStop Offset="0" Color="#FFD09C14" />
                                            <GradientStop Offset="0.3" Color="#FFFCFC80" />
                                            <GradientStop Offset="0.5" Color="#FFD09C14" />
                                            <GradientStop Offset="0.6" Color="#FFFCFC80" />
                                            <GradientStop Offset="1" Color="#FFD09C14" />
                                        </ConicGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock FontSize="18" Margin="0,-10,0,10"
                                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                    <Run Text="You scored" />
                                    <Run Text="{Binding Score}" FontWeight="Bold" />
                                    <Run Text="in" />
                                    <Run Text="{Binding Moves}" FontWeight="Bold" />
                                    <Run Text="moves!" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button
                                        Classes="CasinoButtonStyle" Width="120"
                                        Margin="4" Content="Play Again" Command="{Binding NewGameCommand}" />
                                    <Button
                                        Classes="CasinoButtonStyle" Width="120"
                                        Margin="4" Content="Back to Game" Command="{Binding NavigateToCasinoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </controls:GoldTrayBorder>
                </controls:GoldTrayBorder>
            </Border>

        </ControlTemplate>

        <ControlTemplate x:Key="DeckControls" x:DataType="vm:CardGameViewModel">
            <Panel Height="64" x:CompileBindings="True" x:DataType="vm:CardGameViewModel">
                <Viewbox Stretch="Uniform" VerticalAlignment="Bottom">
                    <controls:ConnectedTray Classes="downDeck" UseLocalFrameWhenIdle="True"
                                            Theme="{StaticResource {x:Type controls:ConnectedTray}}"
                                            Template="{StaticResource ConnectedTrayTemplate}"
                                            Classes.animateUp="{Binding !IsGameWon}" Margin="0,0,0,-15"
                                            FrameShadow="0 -6 30 -9 Black">
                        <DockPanel LastChildFill="True">
                            <controls:CasinoButton DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Classes="goldenDeck" Content="Deal"
                                    Command="{Binding NewGameCommand}" />

                            <controls:CasinoButton DockPanel.Dock="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                                    Classes="goldenDeck" Content="Undo"
                                    Command="{Binding UndoCommand}" />

                            <controls:CasinoButton DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Classes="goldenDeck" Content="Back"
                                    Command="{Binding  NavigateToCasinoCommand}" />

                            <controls:CasinoButton DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                    Classes="goldenDeck" Content="Auto"
                                    Command="{Binding AutoMoveCommand}" />

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Margin="20,5">

                                <TextBlock TextAlignment="Center" VerticalAlignment="Center" MinWidth="60">
                                    <Run FontSize="14" TextDecorations="Underline" FontWeight="SemiBold"
                                         Text="SCORE" />
                                    <LineBreak />
                                    <Run FontSize="24" Text="{Binding Score}" />
                                </TextBlock>
                                <TextBlock TextAlignment="Center" VerticalAlignment="Center" MinWidth="60">
                                    <Run FontSize="14" TextDecorations="Underline" FontWeight="SemiBold"
                                         Text="MOVES" />
                                    <LineBreak />
                                    <Run FontSize="24" Text="{Binding Moves}" />
                                </TextBlock>
                                <TextBlock TextAlignment="Center" VerticalAlignment="Center" MinWidth="70">
                                    <Run FontSize="14" TextDecorations="Underline" FontWeight="SemiBold"
                                         Text="TIME" />
                                    <LineBreak />
                                    <Run FontSize="24"
                                         Text="{Binding ElapsedTime, Converter={StaticResource TimeSpanToShortStringConverter}, Mode=OneWay}" />
                                </TextBlock>

                            </StackPanel>
                        </DockPanel>
                    </controls:ConnectedTray>

                </Viewbox>
            </Panel>
        </ControlTemplate>

        <DataTemplate x:Key="PlayingCardDataTemplate" DataType="{x:Type vm:PlayingCardViewModel}" x:DataType="vm:PlayingCardViewModel">
            <Panel
                Width="{StaticResource CardWidth}"
                Height="{StaticResource CardHeight}">
                <Border IsHitTestVisible="False" Background="White" CornerRadius="6"
                        BoxShadow="{Binding $parent[controls:PlayingCard].ContactShadow}"
                        Opacity="{Binding $parent[controls:PlayingCard].ContactShadowOpacity}" />
                <controls:CardArtworkPanel Classes="playingCardBack" IsVisible="{Binding !$parent[controls:PlayingCard].DisplayFaceUp}">
                    <Border
                        Background="White" Cursor="Hand"
                        BorderBrush="Gray"
                        BorderThickness="1" CornerRadius="6">
                        <Image Margin="4" Source="{StaticResource CardBack}" />
                        <Border.RenderTransform>
                            <Rotate3DTransform
                                AngleY="180" />
                        </Border.RenderTransform>
                    </Border>
                </controls:CardArtworkPanel>
                <controls:CardArtworkPanel Classes="playingCardFront" IsVisible="{Binding $parent[controls:PlayingCard].DisplayFaceUp}">
                    <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ContentControl.Content>
                            <MultiBinding Converter="{StaticResource PlayingCardToBrushConverter}">
                                <Binding Path="CardType" />
                                <Binding Path="IsFaceDown" />
                            </MultiBinding>
                        </ContentControl.Content>
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="media:IImage">
                                <Border Background="White" Cursor="Hand" BorderBrush="Gray"
                                        BorderThickness="1" CornerRadius="6">
                                    <Image Margin="4" Source="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </controls:CardArtworkPanel>
            </Panel>
        </DataTemplate>
    </Styles.Resources>

    <Style Selector="TextBlock.CasinoTextStyle">
        <Setter Property="Foreground" Value="#99FFFFFF" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="controls|CardStackPlacementControl.StackMarker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="6" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="Width" Value="{StaticResource CardWidth}" />
        <Setter Property="Height" Value="{StaticResource CardHeight}" />
        <Setter Property="Margin"
                Value="{OnFormFactor {StaticResource CardThickness}, Mobile={StaticResource CardThicknessMobile}}" />
    </Style>

    <Style Selector="Panel.SuitMarker">
        <Setter Property="Width" Value="{StaticResource CardWidth}" />
        <Setter Property="Height" Value="{StaticResource CardHeight}" />
        <Setter Property="Margin"
                Value="{OnFormFactor {StaticResource CardThickness}, Mobile={StaticResource CardThicknessMobile}}" />
    </Style>

    <Style Selector="Panel.SuitMarker Image">
        <Setter Property="Opacity" Value="0.2" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="RenderTransform" Value="scaleX(0.6) scaleY(0.6)" />
    </Style>

    <Style Selector="controls|CardStackPlacementControl.RunMarker">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{StaticResource CardWidth}" />
        <Setter Property="BorderThickness" Value="6" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="0.8" />

                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin"
                Value="{OnFormFactor {StaticResource CardThickness}, Mobile={StaticResource CardThicknessMobile}}" />
    </Style>

    <Style Selector="Button.CasinoButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="4" BorderThickness="2" CornerRadius="15" BorderBrush="#66FFFFFF"
                        Background="#11FFFFFF"
                        Cursor="Hand">
                        <ContentPresenter
                            TextElement.Foreground="#99FFFFFF"
                            TextElement.FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.goldenDeck">
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <controls:GoldButtonChrome Name="PART_GoldChrome" BorderThickness="2" CornerRadius="6"
                                           Padding="5,0" Cursor="Hand"
                                           Background="{StaticResource CasinoGoldFace}"
                                           BorderBrush="{StaticResource CasinoGoldEdge}"
                                           Pressed="{TemplateBinding IsPressed}">
                    <ContentPresenter TextElement.FontSize="24" TextElement.Foreground="Black"
                                      TextElement.FontWeight="Bold" HorizontalAlignment="Center"
                                      Content="{TemplateBinding Content}" />
                </controls:GoldButtonChrome>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.goldenDeck:pointerover /template/ controls|GoldButtonChrome, Button.goldenDeck:focus-visible /template/ controls|GoldButtonChrome">
        <Setter Property="Active" Value="True" />
    </Style>
    <Style Selector="Button.goldenDeck:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.goldenDeck:disabled /template/ controls|GoldButtonChrome">
        <Setter Property="Active" Value="False" />
    </Style>

    <Style Selector="Button.goldenTray[IsEnabled=False], Button.goldenTray:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="controls|ConnectedTray.downDeck">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|ConnectedTray.downDeck:not(.animateUp)">
        <Setter Property="RenderTransform" Value="translateY(70px)" />
    </Style>

    <Style Selector="controls|ConnectedTray.downDeck.animateUp">
        <Setter Property="RenderTransform" Value="translateY(0px)" />
    </Style>

</Styles>
