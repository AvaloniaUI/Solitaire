<UserControl x:Class="Solitaire.Views.Pages.TitleView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pages="clr-namespace:Solitaire.ViewModels.Pages"
             xmlns:controls="clr-namespace:Solitaire.Controls"
             mc:Ignorable="d"
             x:DataType="pages:TitleViewModel"
             TextElement.Foreground="White"
             x:CompileBindings="True"

             d:DesignHeight="300" d:DesignWidth="300">
    <Design.DataContext>
        <pages:TitleViewModel />
    </Design.DataContext>
    <controls:MenuScrollViewer Theme="{StaticResource MenuScrollViewer}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,24">
            <!-- The container for the statistics. -->
            <Viewbox Name="TitleArtwork" Stretch="Uniform" MaxWidth="420" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Height="70" Source="{StaticResource SolitaireGlyph}" Width="300" VerticalAlignment="Center"
                           Margin="20 0 0 -10">

                    </Image>
                    <TextBlock FontFamily="{StaticResource  CasinoFont}" FontSize="130" Text="SOLITAIRE"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Height="40" Margin="0 -30 0 0" FontFamily="{StaticResource Nunito}" FontSize="16"
                                   HorizontalAlignment="Right">
                        <Run Foreground="White" Text="Built with " />
                        <InlineUIContainer>
                            <Image Width="16" Height="16" Margin="-3 3  3 0" Source="{StaticResource Avalonia}" />

                        </InlineUIContainer>
                        <Run Foreground="White" Text="Avalonia UI" />

                    </TextBlock>
                </StackPanel>

            </Viewbox>


            <Panel MaxWidth="360">
                <!-- The casino commands. -->
                <controls:ConnectedTray>
                    <StackPanel Spacing="12" Orientation="Vertical" Margin="10">
                        <controls:CasinoButton DockPanel.Dock="Top" VerticalAlignment="Center"
                                Theme="{StaticResource MenuButton}" Content="Klondike"
                                Command="{Binding NavigateToKlondikeCommand}" />

                        <controls:CasinoButton DockPanel.Dock="Top" VerticalAlignment="Center"
                                Theme="{StaticResource MenuButton}" Content="FreeCell"
                                Command="{Binding NavigateToFreeCellCommand}" />

                        <controls:CasinoButton DockPanel.Dock="Top" VerticalAlignment="Center"
                                Theme="{StaticResource MenuButton}" Content="Spider"
                                Command="{Binding  NavigateToSpiderCommand}" />

                        <Border Height="2" Margin="10 5 10 5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="-1000,1000" EndPoint="1000,0"
                                                     GradientStops="{StaticResource GoldBrush}"
                                                     Transform="rotate(120deg)" />
                            </Border.Background>
                        </Border>

                        <controls:CasinoButton DockPanel.Dock="Top" VerticalAlignment="Center"
                                Theme="{StaticResource MenuButton}" Content="Statistics"
                                Command="{Binding NavigateToStatisticsCommand}" />

                        <controls:CasinoButton DockPanel.Dock="Top" VerticalAlignment="Center"
                                Theme="{StaticResource MenuButton}" Content="Settings"
                                Command="{Binding NavigateToSettingsCommand}" />

                    </StackPanel>
                </controls:ConnectedTray>

            </Panel>
        </StackPanel>
    </controls:MenuScrollViewer>
</UserControl>
